# Local datasets and generated numerical results
/data/*
!/data/.gitkeep
/results/*
!/results/.gitkeep

# Local Workshop 1 dataset and source metadata
/workshops/workshop1/dry_bean.csv
/workshops/workshop1/dry_bean_metadata.json

# Temporary tools, downloads, and intermediate files
/tmp/

# Local Python environments and caches
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter autosave checkpoints (keep the actual notebooks and their outputs)
.ipynb_checkpoints/

# LaTeX build intermediates (keep source files and PDF figure assets)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
/report/*.log

# Local report previews and upload bundles; current sources live in report/
/report/main.pdf
/report/tasks_*.pdf
/report/overleaf_tasks_*.zip

# Reproducible Assignment 3 notebook previews; report/Images/ keeps final PDFs
/figures/assignment3/combined/09_*
/figures/assignment3/combined/10_*
/figures/assignment3/lda_selected/

# Local environment variables (keep shareable example files)
.env
.env.*
!.env.example
!.env.template

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
